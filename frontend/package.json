{
  "name": "@wails3-template/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Wails v3 桌面模板的渲染层（Vue 3.5 + Vite Plus）",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc --noEmit -p tsconfig.json && vp build",
    "build:dev": "vp build --mode development --minify false",
    "preview": "vp preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@vueuse/core": "15.0.0",
    "@wailsio/runtime": "3.1.0",
    "axios": "1.21.0",
    "dayjs": "1.11.23",
    "naive-ui": "2.45.3",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-i18n": "11.4.18",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.151",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "6.0.3",
    "unocss": "66.12.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "vue-tsc": "3.3.14"
  }
}
